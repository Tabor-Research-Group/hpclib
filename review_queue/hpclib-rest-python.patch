+            print(f"agent_profiles: rest_python is an absolute path on the cluster (letters, digits and . _ + - /), "
+                  f"not {value!r}", file=sys.stderr)
+            return 2
         if key == "auto_approve_templates" and value not in APPROVE_MODES:

     launch=(--login-node)   # no job, so no sbatch options
   fi
+  # the profile's rest_python, for a cluster whose compute nodes lack the Python setup_agents found
+  rest_python=$(_hpclib_agent_profiles get "$name" rest_python 2>/dev/null) || rest_python=''
   while [ "$#" -gt 0 ]; do
     case "$1" in
       --auto-approve-templates|--auto-approve-templates=new) approve=new ;;
@@ -1446,10 +1448,15 @@ function agent_tunnel {
       --auto-approve-templates=*)
         echo "agent_tunnel: --auto-approve-templates takes new or all" >&2
         return 2 ;;
+      # launch_tunnel reads only the first --env, so the profile's variable and this one are joined below
+      --env=*) env_list="${env_list:+$env_list,}${1#--env=}" ;;
       *) launch+=("$1") ;;
     esac
     shift
   done
+  case ",$env_list," in *,HPC_REST_PYTHON=*) rest_python='' ;; esac     # an option given here wins
+  [ -n "$rest_python" ] && env_list="HPC_REST_PYTHON=$rest_python${env_list:+,$env_list}"
+  [ -n "$env_list" ] && launch+=("--env=$env_list")
   # an option for the REST server, not launch_tunnel; it applies only while jobs are sandboxed
   [ -n "$approve" ] && allow+=("--auto-approve-templates=$approve")
   # if this ssh is the one that logs in, keep the login as long as the profile says (default 12h)

         self.assertNotIn("--time=12:00:00", res.stdout)                            # no job, no sbatch options
         self.assertEqual(agent_profiles.cmd_set(self.live, "rest_on=elsewhere"), 2)
 
+    def test_rest_python(self):
+        url = f"/api/clusters/{self.live}/settings"
+        self.assertEqual(self.call("GET", url)[1]["rest_python"], "")
+        status, out = self.call("PUT", url, {"rest_python": " /sw/eb/sw/Python/3.11.5/bin/python3 "})
+        self.assertEqual((status, out["rest_python"]), (200, "/sw/eb/sw/Python/3.11.5/bin/python3"), out)
+        self.assertEqual(self.call("PUT", url, {"rest_on": "login"})[1]["rest_python"],
+                         "/sw/eb/sw/Python/3.11.5/bin/python3")                         # kept when not sent
+        for bad in ("python3", "/a b/python3", "/a,HPC_X=1/python3", "/py;rm", 3):
+            self.assertEqual(self.call("PUT", url, {"rest_python": bad})[0], 422, bad)
+        self.assertEqual(agent_profiles.cmd_set(self.live, "rest_python=python3"), 2)
+        self.assertEqual(self.call("PUT", url, {"rest_python": ""})[1]["rest_python"], "")
+        self.assertEqual(agent_profiles.load(self.live)["rest_python"], "")
+
+    def test_agent_tunnel_passes_rest_python(self):
+        repo = Path(__file__).resolve().parents[1]
+        agent_profiles.cmd_set(self.live, "rest_python=/sw/py/bin/python3")
+        script = (f'source {repo / "hpclib" / "hpclib.sh"}; launch_tunnel() {{ printf "%s\\n" "$*"; }}; '
+                  f'agent_tunnel {self.live}; agent_tunnel {self.live} --env=A=1,B=2; '
+                  f'agent_tunnel {self.live} --env=HPC_REST_PYTHON=/mine/python3; '
+                  f'_hpclib_agent_profiles set {self.live} rest_python=; agent_tunnel {self.live}')
+        res = subprocess.run(["bash", "-c", script], capture_output=True, text=True, timeout=60,
+                             env=dict(os.environ, HPCLIB_AGENTS_DIR=str(self.agents)))
+        plain, merged, theirs, unset = res.stdout.splitlines()
+        self.assertIn(" --env=HPC_REST_PYTHON=/sw/py/bin/python3 -- ", plain)           # before the server's options
+        self.assertIn(" --env=HPC_REST_PYTHON=/sw/py/bin/python3,A=1,B=2 -- ", merged)  # one --env: launch_tunnel reads one
+        self.assertEqual(theirs.count("--env="), 1)
+        self.assertIn("--env=HPC_REST_PYTHON=/mine/python3 ", theirs)
+        self.assertNotIn("--env", unset)
+

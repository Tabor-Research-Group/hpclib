+def _squash_lines():
+    """Bash lines, run in the project after `uv sync`: pack .venv into SQUASH_IMAGE and empty .venv, the image's
+    mount point. .venv is emptied before the new image replaces the old one, so a job submitted meanwhile gets
+    either the old image or the new one, never an emptied .venv without an image."""
+    tmp = SQUASH_IMAGE + ".tmp"
+    return [
+        "hpc_mksquashfs=$(command -v mksquashfs || echo /usr/sbin/mksquashfs)",
+        '[ -x "$hpc_mksquashfs" ] || { echo "hpclib: squash needs mksquashfs (squashfs-tools) where the REST '
+        'server runs; the environment is synced, unpacked, in .venv" >&2; exit 5; }',
+        f"echo '$ mksquashfs .venv {SQUASH_IMAGE}'",
+        f"rm -f {tmp}",
+        f'"$hpc_mksquashfs" .venv {tmp} -noappend -no-xattrs -quiet -no-progress || {{ rm -f {tmp}; exit 6; }}',
+        "find .venv -mindepth 1 -delete",
+        f"mv -f {tmp} {SQUASH_IMAGE}",
+        f'echo "packed .venv into {SQUASH_IMAGE} ($(du -h {SQUASH_IMAGE} | cut -f1)); jobs mount it on .venv"',
+    ]

{
  "mcpServers": {
    "hpclib": {
      "command": "/path/to/python-with-mcp",
      "args": [
        "/path/to/hpclib/hpclib/servers/rest_mcp.py",
        "--url", "http://127.0.0.1:PORT",
        "--token-file", "/Users/me/.config/hpclib/agents/user@login.example/agent_token",
        "--local-root", "/Users/me/Desktop/scans"
      ]
    }
  }
}
